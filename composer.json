{
  "name": "wexample/symfony-check",
  "description": "Non-blocking checks on any object: checkers report findings with a severity, aggregated per subject",
  "type": "library",
  "license": "MIT",
  "version": "1.0.1",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyCheck\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyCheck\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=12.0.0"
  },
  "require-dev": {
    "phpunit/phpunit": "*",
    "wexample/symfony-testing": ">=2.0.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
